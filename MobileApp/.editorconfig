root = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 140

ktlint_standard_function-naming = disabled
ktlint_standard_value-parameter-comment = disabled
ktlint_standard_max-line-length = disabled
