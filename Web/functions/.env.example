# Copy to functions/.env and adjust. Non-secret config only.
#
# Which AI providers to deploy (comma-separated). A provider's endpoints — and its
# required secret — are only included when it is listed here. Default (this file/line
# absent) deploys ONLY Replicate, so you only need REPLICATE_API_KEY to get started:
#   (unset / no .env)              -> only Replicate endpoints (only REPLICATE_API_KEY needed)
#   AI_PROVIDERS=openai            -> only OpenAI endpoints (only OPENAI_API_KEY needed)
#   AI_PROVIDERS=replicate,openai  -> both (needs both secrets)
AI_PROVIDERS=replicate

# NOTE: API keys are NOT set here. They are secrets — store them in Google Cloud
# Secret Manager as OPENAI_API_KEY / REPLICATE_API_KEY (see integrate-web-proxy skill).
# Never commit real keys to .env.
